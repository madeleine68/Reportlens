# Copy to .env and fill in. Never commit .env.

# --- Postgres (docker compose reads these too) ---
POSTGRES_USER=reportlens
POSTGRES_PASSWORD=reportlens
POSTGRES_DB=reportlens
POSTGRES_HOST=localhost
# Use 5433 if a local Postgres already owns 5432
POSTGRES_PORT=5432

# --- LLM (any OpenAI-compatible endpoint) ---
# Default: Groq free tier. Get a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-key-here
LLM_MODEL_MAIN=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b
# Retries on rate limits; the free tier needs several during eval runs
LLM_MAX_RETRIES=6
# Main-model price in USD per million tokens, for eval cost/query (0 on the free tier)
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

# Alternative: Google Gemini free tier (https://aistudio.google.com/apikey)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL_MAIN=gemini-2.5-flash
# LLM_MODEL_FAST=gemini-2.5-flash-lite

# Alternative: local Ollama (no key needed; any non-empty value works)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL_MAIN=llama3.1:8b
# LLM_MODEL_FAST=llama3.2:3b

# --- Chunking: naive | contextual (give each its own POSTGRES_DB to compare) ---
CHUNKING=naive

# --- Retrieval experiments (off = Phase 1 baseline) ---
RETRIEVAL_USE_FILTERS=false
# vector | keyword | hybrid
RETRIEVAL_MODE=vector
# Cross-encoder reranking of the top candidates
RETRIEVAL_RERANK=false

# --- Phase 3 SQL tool: LLM-written SQL runs as this read-only role (created automatically) ---
SQL_READER_USER=reportlens_reader
SQL_READER_PASSWORD=reportlens_reader
SQL_TIMEOUT_MS=5000
SQL_ROW_LIMIT=50

# --- Phase 3 graph: Neo4j (docker compose reads these too; password needs 8+ characters) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=reportlens
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

LOG_LEVEL=INFO
