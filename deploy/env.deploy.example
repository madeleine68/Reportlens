# Copy to .env.deploy in the project root (git-ignored) and fill in. Read by
# scripts/deploy_data.py and scripts/deploy_cloudrun.py; never printed.
# LLM_* values not set here are taken from .env.

# Google Cloud Run: the project id (console.cloud.google.com) and region. Run `gcloud auth login` first.
GCP_PROJECT=
GCP_REGION=us-east1

# Neon (console.neon.tech): the connection string of the project's database, with sslmode.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Password for the SQL tool's read-only role, created on Neon by deploy_data.py. Make it long.
SQL_READER_PASSWORD=

# Neo4j AuraDB Free (console.neo4j.io): from the credentials file it offers on creation.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# The public demo: the password you share with interviewers, and limits that protect the quota.
DEMO_PASSWORD=
RATE_LIMIT_PER_HOUR=10
DAILY_QUESTION_CAP=100
WEB_SEARCH=false
SELF_RAG=false
ROUTED_CORRECTIVE=true
